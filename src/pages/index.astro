---
const previousEditions = [
	{ year: '2026', url: 'https://2026.harmonycon.org' },
	{ year: '2025', url: 'https://2025.harmonycon.org' },
	{ year: '2024', url: 'https://2024.harmonycon.org' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f4f1eb" />
		<meta
			name="description"
			content="HarmonyCon 2027 is coming soon. Visit the 2025 and 2026 editions."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:title" content="HarmonyCon 2027 — Coming Soon" />
		<meta
			property="og:description"
			content="HarmonyCon 2027 is coming soon."
		/>
		<meta property="og:url" content="https://harmonycon.org/" />
		<link rel="canonical" href="https://harmonycon.org/" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Grandstander:wght@600;700&display=swap"
			rel="stylesheet"
		/>
		<title>HarmonyCon 2027 — Coming Soon</title>
	</head>
	<body>
		<main>
			<h1>COMING SOON!</h1>

			<nav aria-label="Previous HarmonyCon editions">
				{
					previousEditions.map(({ year, url }) => (
						<a href={url} aria-label={`${year} HarmonyCon edition`}>
							{year}
						</a>
					))
				}
			</nav>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #f4f1eb;
		color: #191917;
		font-family: "Grandstander", ui-rounded, "Arial Rounded MT Bold", sans-serif;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
	}

	main {
		display: grid;
		min-height: 100vh;
		min-height: 100svh;
		padding: clamp(1.5rem, 5vw, 4rem);
		place-content: center;
		text-align: center;
	}

	h1 {
		margin: 0;
		font-size: clamp(3.5rem, 13vw, 9.5rem);
		font-weight: 700;
		letter-spacing: 0.02em;
		line-height: 0.88;
	}

	nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: clamp(2.5rem, 8vw, 5rem);
		margin-top: clamp(2.5rem, 7vw, 5rem);
	}

	a {
		border-bottom: 3px solid currentColor;
		color: inherit;
		font-size: 3rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		padding: 0.25rem 0;
		text-decoration: none;
	}

	a:hover {
		border-bottom-width: 4px;
	}

	a:focus-visible {
		border-radius: 0.125rem;
		outline: 2px solid currentColor;
		outline-offset: 0.35rem;
	}

	@media (max-width: 30rem) {
		h1 {
			font-size: clamp(3.25rem, 20vw, 5rem);
		}
	}
</style>
