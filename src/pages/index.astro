---
const previousEditions = [
	{ year: '2026', url: 'https://2026.harmonycon.org' },
	{ year: '2025', url: 'https://2025.harmonycon.org' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f4f1eb" />
		<meta
			name="description"
			content="HarmonyCon 2027 is coming soon. Visit the 2025 and 2026 editions."
		/>
		<meta property="og:type" content="website" />
		<meta property="og:title" content="HarmonyCon 2027 — Coming Soon" />
		<meta
			property="og:description"
			content="HarmonyCon 2027 is coming soon."
		/>
		<meta property="og:url" content="https://harmonycon.org/" />
		<link rel="canonical" href="https://harmonycon.org/" />
		<title>HarmonyCon 2027 — Coming Soon</title>
	</head>
	<body>
		<main>
			<p>HarmonyCon 2027</p>
			<h1>Coming Soon</h1>

			<nav aria-label="Previous HarmonyCon editions">
				{
					previousEditions.map(({ year, url }) => (
						<a href={url} aria-label={`${year} HarmonyCon edition`}>
							{year}
						</a>
					))
				}
			</nav>
		</main>
	</body>
</html>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(html) {
		background: #f4f1eb;
		color: #191917;
		font-family:
			Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
		font-synthesis: none;
		text-rendering: optimizeLegibility;
	}

	:global(body) {
		margin: 0;
		min-width: 320px;
	}

	main {
		display: grid;
		min-height: 100vh;
		min-height: 100svh;
		padding: clamp(1.5rem, 5vw, 4rem);
		place-content: center;
		text-align: center;
	}

	p {
		margin: 0 0 1.25rem;
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	h1 {
		margin: 0;
		font-size: clamp(3.5rem, 13vw, 9.5rem);
		font-weight: 450;
		letter-spacing: -0.065em;
		line-height: 0.88;
	}

	nav {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		margin-top: clamp(2.5rem, 7vw, 5rem);
	}

	a {
		border-bottom: 1px solid currentColor;
		color: inherit;
		font-size: 0.875rem;
		letter-spacing: 0.08em;
		padding: 0.25rem 0;
		text-decoration: none;
	}

	a:hover {
		border-bottom-width: 2px;
	}

	a:focus-visible {
		border-radius: 0.125rem;
		outline: 2px solid currentColor;
		outline-offset: 0.35rem;
	}

	@media (max-width: 30rem) {
		h1 {
			font-size: clamp(3.25rem, 20vw, 5rem);
		}
	}
</style>
